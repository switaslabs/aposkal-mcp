# Aposkal MCP — örnek yapılandırma (Switas Consultancy, https://switas.com)
# Bu dosyayı .env adıyla kopyalayıp doldurun. .env dosyasını ASLA commit etmeyin.
# Çalıştırma: node --env-file=.env dist/index.js

# --- Kimlik bilgileri (zorunlu) -----------------------------------------
# Aposkal > Profil > Api Anahtarları
APOSKAL_API_KEY=
APOSKAL_API_SECRET=

# --- Ortam (zorunlu, varsayılanı yok) -----------------------------------
# live -> https://api.aposkal.com   test -> https://api.dev.aposkal.com
APOSKAL_ENV=live

# --- Güvenlik -----------------------------------------------------------
# readonly (varsayılan) | write | full
APOSKAL_MODE=readonly
# GİB / SGK / üçüncü taraflara veri gönderen işlemlere izin ver
# (resmileştirme, iptal, e-fatura yanıtı, SGK bildirgesi, e-posta...). Varsayılan: false
APOSKAL_ALLOW_EXTERNAL=false
# Hassas işlemlere izin ver (SSO bileti, webhook, entegrasyon, firma ayarları,
# toplu veri silme, ödeme). Varsayılan: false
APOSKAL_ALLOW_SENSITIVE=false
# Sunucunun erişebileceği firma ID'leri, virgülle ayrılmış (önerilir)
APOSKAL_COMPANY_IDS=
# Araç çağrısında companyId verilmezse kullanılacak firma
APOSKAL_DEFAULT_COMPANY_ID=

# --- Araçlar ------------------------------------------------------------
# Ayrı araç olarak açılacak gruplar, virgülle ayrılmış (ör. document,account,product) ya da "all"
APOSKAL_TOOLSETS=

# --- Dosyalar -----------------------------------------------------------
# İkili indirmelerin (PDF vb.) kaydedileceği klasör. Varsayılan: <sistem tmp>/aposkal-mcp/downloads
APOSKAL_DOWNLOAD_DIR=
# Yalnızca bu klasördeki dosyalar yüklenebilir (multipart uçlar). Boş = yükleme kapalı
APOSKAL_UPLOAD_DIR=

# --- Diğer --------------------------------------------------------------
APOSKAL_TIMEOUT_MS=30000
APOSKAL_MAX_RESPONSE_CHARS=60000
# error | warn | info | debug  (loglar stderr'e yazılır, sırlar gizlenir)
APOSKAL_LOG_LEVEL=warn
